# Application Configuration
PROJECT_NAME="PDF OCR Converter API"
VERSION="1.0.0"
ENVIRONMENT="development"
DEBUG=true

# API Configuration
API_V1_STR="/api/v1"

# Security
SECRET_KEY="your-secret-key-change-in-production-must-be-at-least-32-characters"
ALLOWED_HOSTS="*"

# Session Management
SESSION_EXPIRE_HOURS=24

# File Processing
MAX_FILE_SIZE_MB=50
MAX_FILES_PER_BATCH=10
UPLOAD_DIR="uploads"
PROCESSED_DIR="processed"

# Google OAuth (Optional - for token validation)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Logging
LOG_LEVEL="INFO"
LOG_FORMAT="json"

# Rate Limiting
RATE_LIMIT_PER_MINUTE=60
